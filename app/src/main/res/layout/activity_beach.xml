<?xml version="1.0" encoding="utf-8"?>

 <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding = "16dp">

        <ImageView
            android:id = "@+id/beachImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Beach Image"
            android:src="@android:drawable/ic_menu_gallery"/>

        <!-- Beach Name -->
        <TextView
            android:id="@+id/beachName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/blue_dark"
            android:layout_marginBottom="8dp"
            android:text="Beach Name" />

        <!-- Beach Blurb -->
        <TextView
            android:id="@+id/beachBlurb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/blue_hint"
            android:layout_marginBottom="16dp"
            android:text="Beach Description" />

        <!-- real time weather info displayed on page-->
        <TextView
            android:id="@+id/beachTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Opening Hours: ______"
            android:textSize="16sp"
            android:textColor="@color/blue_dark"/>

        <TextView
            android:id="@+id/weatherInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Loading weather data..."
            android:textSize="16sp"
            android:textColor="@color/blue_hint"/>


            <!--dynamically load the tags here
<com.google.android.flexbox.FlexboxLayout
            android:id="@+id/tagLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            app:flexWrap="wrap"
            app:justifyContent="flex_start">
             </com.google.android.flexbox.FlexboxLayout>
            -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding = "16dp"
        android:gravity = "center_vertical">

        <TextView
            android:id="@+id/tags"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:text="Tags:"
            android:textColor="@color/blue_hint"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/exampleTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:text="Surfing"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>

        <TextView
            android:id="@+id/review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="___ Beach Reviews"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/blue_dark"/>

    <LinearLayout
            android:id="@+id/reviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/exampleReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Good beach for surfing and water sports! - @user1234"
                android:textColor="@color/blue_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/editReview"
            android:layout_width="134dp"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="Add/Edit Review"
            android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>



